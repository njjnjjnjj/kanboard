{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kanboard",
  "version": "0.4.0",
  "identifier": "com.local.kanban",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "看板",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 780,
        "maximized": true,
        "backgroundColor": "#e8e9e6",
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kanboard",
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {}
}
