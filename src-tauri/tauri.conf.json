{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地板",
  "version": "0.1.0",
  "identifier": "com.local.kanban",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "本地板",
        "width": 1280,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:kanboard.db"]
    }
  }
}
